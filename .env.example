# ==============================================================================
# PRESTIGE PAWS NYC - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust variables for your target deployment environment.
# ==============================================================================

# Core Django Settings
DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-very-long-and-secure-random-secret-key-for-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.prestigepaws.nyc

# Database Configuration
# Leave blank to use default SQLite in local development (db.sqlite3)
# For production PostgreSQL: postgres://username:password@localhost:5432/prestigepaws_db
DATABASE_URL=

# Business & Atelier Settings
ATELIER_NAME="Prestige Paws NYC"
ATELIER_ADDRESS="450 Lexington Avenue, Suite 1800, New York, NY 10017"
ATELIER_PHONE="(212) 555-PAWS"
CONCIERGE_EMAIL="concierge@prestigepaws.nyc"
STANDARD_DELIVERY_FEE=250.00
NYC_TAX_RATE=0.0888

# Stripe Payment Gateway
# Obtain API keys from Stripe Dashboard (https://dashboard.stripe.com/test/apikeys)
STRIPE_PUBLIC_KEY=pk_test_placeholder_key_for_client_side
STRIPE_SECRET_KEY=sk_test_placeholder_key_for_backend
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_signing_secret

# Payment Sandbox Simulator
# Enables safe instant card checkout simulation when Stripe keys are unset
ENABLE_PAYMENT_SIMULATOR=True

# Mapping & Live Telemetry Logistics
# Leaflet.js uses OpenStreetMap standard tile layers by default
DEFAULT_ORIGIN_LATITUDE=40.7527
DEFAULT_ORIGIN_LONGITUDE=-73.9772
TELEMETRY_POLL_INTERVAL_SECONDS=5

# Email & Notification Settings (SMTP for Production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-or-smtp-api-key
DEFAULT_FROM_EMAIL="Prestige Paws Concierge <concierge@prestigepaws.nyc>"

# Security & HTTPS (Set to True in Production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
